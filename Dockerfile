# Сборка и запуск прототипа: фронт (Vite) + мини-сервер (Express) в одном образе.
# На Railway: Root Directory = prototype, том примонтирован в /data (DATA_DIR=/data),
# порт задаётся переменной окружения (PORT — Railway сам). Пароля нет: доступ открыт.
#
# ОБРАЗ СОБИРАЕТСЯ В ДВА ЭТАПА. Раньше он был одноэтапным, и на сервер уезжало
# всё подряд: исходники, конфиги и полный набор зависимостей вместе с Vite,
# TypeScript, Tailwind и ESLint. Серверу из этого нужен только express: он
# отдаёт готовую сборку и небольшой API. Лишнее замедляло каждый деплой —
# образ дольше выгружался в реестр и дольше поднимался.
#
# Теперь первый этап собирает фронт и остаётся на машине сборки, а в готовый
# образ едут только три вещи: сборка фронта, папка server и зависимости без
# инструментов разработки.

# ── Этап 1. Сборка фронта ───────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

# Зависимости отдельным слоем — кешируется, пока не менялся package-lock.
COPY package.json package-lock.json ./
RUN npm ci

# Исходники и сборка фронта. BASE_PATH=/ — ассеты грузятся от корня домена
# (в отличие от GitHub Pages, где base — подкаталог).
COPY . .
ENV BASE_PATH=/
RUN npm run build

# ── Этап 2. То, что поедет на сервер ────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production

# Только рабочие зависимости: инструменты сборки в готовом образе не нужны.
# Кеш npm чистим сразу — он остался бы слоем и вырос бы в размере образа.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Готовая сборка фронта и сам сервер. Исходники (src) не копируем: они уже
# превратились в dist на первом этапе.
COPY --from=build /app/dist ./dist
COPY server ./server

# Сервер слушает process.env.PORT (его задаёт Railway) и отдаёт dist + /api.
CMD ["node", "server/index.js"]
